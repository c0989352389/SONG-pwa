{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "serve (npx serve, 推薦)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3000", "."],
      "port": 3000
    },
    {
      "name": "http-server (npx http-server)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "-p", "8080", "-c-1", "."],
      "port": 8080
    },
    {
      "name": "python http.server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    }
  ]
}
